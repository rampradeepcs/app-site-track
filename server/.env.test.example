# For `npm test`. The suite serves its own JWKS on 4555 and signs its own
# tokens, so SUPABASE_URL points at it rather than at the real project.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=http://127.0.0.1:4555
JWT_AUDIENCE=authenticated
PORT=4610
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=2000
LOG_LEVEL=warn
