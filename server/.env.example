# The database. Use the pooler host for a serverless or containerised deploy.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Where tokens are minted. The API fetches this project's public JWKS from
# here and verifies every request locally — no secret, no round trip.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional. The audience GoTrue puts in its tokens; leave as-is unless the
# project was configured otherwise.
JWT_AUDIENCE=authenticated

PORT=4000
HOST=0.0.0.0

# Comma-separated origins allowed to call this API from a browser. The
# Capacitor app sends Origin: https://localhost.
CORS_ORIGINS=http://localhost:3000,https://localhost,https://app-site-track.vercel.app

# Requests per minute per IP. Raise for a busy tenant.
RATE_LIMIT_PER_MINUTE=240
