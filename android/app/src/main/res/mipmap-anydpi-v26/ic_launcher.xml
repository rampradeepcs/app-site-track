<?xml version="1.0" encoding="utf-8"?>
<!--
  Bitmap layers, as Android Studio's asset tool would make them, rather than
  a vector wrapped in a layer-list: every renderer that ever draws this icon
  — the launcher, recents, the system splash, an OEM's blurred backdrop —
  handles a bitmap foreground the same way. The foreground is the white mark
  on transparency inside the safe circle; the background is black.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
