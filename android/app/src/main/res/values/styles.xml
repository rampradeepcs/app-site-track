<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The app is a dark product. The generated theme inherited from
      Theme.AppCompat.Light, so every moment the system painted the window
      itself — launch, resume, rotation, the gap before the WebView draws —
      was light, and the app arriving over it read as a white flash.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/wf_black</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!--
          Was @null, which lets whatever is behind show through until the
          WebView paints. Black, so there is nothing to see.
        -->
        <item name="android:background">@color/wf_black</item>
        <item name="android:windowBackground">@color/wf_black</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!--
          The modern attributes are what Android 12 and later actually honour;
          android:background is the fallback the older path draws. Both point
          at the same black and the same mark, so the launch looks identical
          either way, and postSplashScreenTheme is what hands the window over
          to the app's own theme instead of leaving the launch theme in place
          for the life of the activity.
        -->
        <item name="windowSplashScreenBackground">@color/wf_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wf_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
