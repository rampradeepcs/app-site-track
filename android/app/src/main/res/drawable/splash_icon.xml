<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch icon: the mark set in the 240dp square the system expects,
  with enough room that it sits inside the 160dp circle the system masks
  it to. The mark is 2.4:1, so 140dp wide is the most that fits the circle
  with its corners; the insets centre it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/wf_mark"
        android:left="50dp"
        android:right="50dp"
        android:top="91dp"
        android:bottom="91dp" />
</layer-list>
