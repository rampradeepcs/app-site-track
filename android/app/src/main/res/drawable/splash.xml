<?xml version="1.0" encoding="utf-8"?>
<!--
  What the window shows before the WebView has painted.

  Black ground and the app's own mark, so the moment the web layer takes
  over there is nothing to see change. The image this replaced was the old
  identity — an orange hexagon on navy — handing over to a black screen
  with a white monogram, which is the flash at launch.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/wf_black" />
    <item android:drawable="@drawable/wf_mark" android:gravity="center" />
</layer-list>
