<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_wf"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_wf_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Single sign-on returns here. OAuth cannot run in the app's
                 own WebView — Google rejects embedded user agents outright —
                 so the sign-in happens in the system browser and comes back
                 on this scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.workfence.workforce" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Geofenced check-in and route tracking. COARSE is declared alongside
         FINE because Android 12+ lets the user grant approximate location
         only; the app degrades to a distance estimate rather than failing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Location is foreground-only, deliberately. The shift route is recorded
         by the WebView while the app is open; nothing tracks a pocketed phone.
         ACCESS_BACKGROUND_LOCATION, FOREGROUND_SERVICE and
         FOREGROUND_SERVICE_LOCATION were declared here for a year without a
         single line of code behind them — no Service subclass, no
         startForeground call, and Capacitor only ever requests COARSE+FINE
         (BridgeWebChromeClient.onGeolocationPermissionsShowPrompt), so the
         background permission could not be granted from inside the app at all.
         They are gone. Bringing background tracking back means bringing all
         three back together, with a typed foreground service, its ongoing
         notification, POST_NOTIFICATIONS, and a Play declaration carrying a
         demo video and an annual re-review. Do not re-add them speculatively.

         POST_NOTIFICATIONS went with them: nothing in this app posts an
         Android notification. The bell on the profile screen is an in-app
         feed, not a system one. -->

    <!-- Check-in / checkout selfies and work-update photos. Capture only.
         Reading the gallery needs no permission and never did: the WebView's
         file input hands back a content URI from the system picker carrying
         its own temporary grant, which is why READ_MEDIA_IMAGES is not here.
         (It used to be — declared with no READ_EXTERNAL_STORAGE beside it for
         API 24-32, which is the tell that it was never load-bearing.) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Checkout voice notes. Capacitor's WebChromeClient asks for BOTH of
         these when the page calls getUserMedia({audio}), and treats the
         request as denied unless every one is granted — so MODIFY_AUDIO_SETTINGS
         has to be declared here even though it is an install-time permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The multi-select crew picker: Android has no multi-select system
         picker, so bulk-inviting a crew means the app draws the contact list
         itself, which requires reading it. Read only — never WRITE_CONTACTS —
         and declining the prompt falls back to the permissionless
         one-at-a-time system picker. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- GPS is essential to the product; a device without it cannot check in. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
